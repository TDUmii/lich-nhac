<Window x:Class="LichNhac.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mây Nhắc" Height="760" Width="1120" Background="#F8FAFC" WindowStartupLocation="CenterScreen"><Grid Margin="28"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.8*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,28,0"><TextBlock Text="MÂY NHẮC" Foreground="#2563EB" FontSize="14" FontWeight="Bold"/><TextBlock Text="Trợ lý lịch của bạn" Foreground="#0F172A" FontSize="34" FontWeight="Bold" Margin="0,8,0,6"/><TextBlock Text="Nhắc đúng lúc, theo cách thật dễ thương." Foreground="#475569" FontSize="16" Margin="0,0,0,24"/><Border Background="White" CornerRadius="24" Padding="24"><StackPanel><TextBlock Text="Nhân vật đang dùng" Foreground="#475569"/><TextBlock x:Name="CharacterName" Text="Mochi • Mèo mây" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,18"/><Border x:Name="CharacterCard" Background="#EEF4FF" CornerRadius="20" Height="150"><Image x:Name="CharacterImage" Stretch="Uniform" Margin="14"/></Border><TextBlock Text="Chọn một bạn đồng hành" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8"/><ComboBox x:Name="CharacterPicker" SelectionChanged="CharacterPicker_Changed" Height="38" FontSize="14"><ComboBoxItem Content="Mochi • Mèo mây" Tag="mochi" IsSelected="True"/><ComboBoxItem Content="Luna • Cáo đêm" Tag="luna"/><ComboBoxItem Content="Bobo • Gấu mật ong" Tag="bobo"/><ComboBoxItem Content="Mầm • Cây nhỏ" Tag="mam"/></ComboBox></StackPanel></Border><Border Background="White" CornerRadius="24" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="Kênh thông báo" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="SoundToggle" Content="Phát âm thanh khi nhắc" IsChecked="True" Margin="0,16,0,8"/><TextBlock Text="Tự tắt sau (giây)" Foreground="#475569" FontSize="13" Margin="0,14,0,5"/><TextBox x:Name="DurationBox" Text="8" Height="34" Padding="10,5" MaxLength="3"/></StackPanel></Border></StackPanel><StackPanel Grid.Column="1"><DockPanel Margin="0,6,0,20"><TextBlock Text="Hôm nay" FontSize="28" FontWeight="Bold"/><Button x:Name="ConnectButton" Content="Đăng nhập Google Calendar" Click="Connect_Click" DockPanel.Dock="Right" Padding="18,10" Background="White" Foreground="#2563EB"/></DockPanel><Border Background="White" CornerRadius="24" Padding="24"><StackPanel><TextBlock x:Name="ConnectionStatus" Text="Chưa kết nối • lịch mẫu" Foreground="#B45309"/><TextBlock Text="Lịch sắp tới" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,18"/><TextBlock x:Name="EventOne" Text="14:30  •  Họp nhóm thiết kế" FontSize="17" Background="#EFF6FF" Padding="16" Margin="0,0,0,10"/><TextBlock x:Name="EventTwo" Text="16:00  •  Tập trung học tiếng Anh" FontSize="17" Background="#F0FDF4" Padding="16"/></StackPanel></Border><Border Background="#0F172A" CornerRadius="24" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="Xem thử thông báo" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Nhân vật sẽ bật ra như một khung chat lớn mà không cướp focus của game." Foreground="#CBD5E1" Margin="0,6,0,16" TextWrapping="Wrap"/><Button Content="Gửi thông báo thử" Click="Test_Click" Height="44" Background="#34D399" BorderThickness="0"/></StackPanel></Border></StackPanel></Grid></Window>
